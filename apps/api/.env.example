DATABASE_URL="postgresql://engecom:engecom_dev_password@localhost:5432/engecom_seguranca?schema=public"
# Used only by `prisma migrate` to create/alter tables. Behind a connection
# pooler that can't run migrations (e.g. Supabase's PgBouncer in transaction
# mode), this must be a direct/session connection instead — see
# prisma/schema.prisma. Without a pooler (e.g. this local setup, or
# Railway's own Postgres), it's the same value as DATABASE_URL.
DIRECT_URL="postgresql://engecom:engecom_dev_password@localhost:5432/engecom_seguranca?schema=public"
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_DOMAIN=""
# Comma-separated list of allowed frontend origins (no trailing slash).
# Same-origin deployments (API also serving the built frontend, e.g. the
# Railway single-service setup) don't strictly need this to match anything
# beyond the default, since same-origin requests carry no Origin header.
# A frontend hosted separately (e.g. on Vercel) MUST be listed here.
WEB_APP_URL="http://localhost:5173"
# 'lax' for same-origin deployments. Set to 'none' when the frontend is on
# a different origin than this API (e.g. Vercel frontend + Railway API) —
# required for the session cookie to be sent cross-site. 'none' is only
# honored by browsers over HTTPS (enforced automatically in code).
COOKIE_SAME_SITE="lax"
UPLOAD_DIR="uploads"
# Storage driver for attachments/avatars: 'local' (disk — needs a persistent
# volume/disk on the host, e.g. Railway/Render paid disks) or 's3' (any
# S3-compatible bucket, e.g. Cloudflare R2 — required on hosts with no
# persistent disk, e.g. Render's free tier). Leave as 'local' for dev.
STORAGE_DRIVER="local"
# Only needed when STORAGE_DRIVER="s3". For Cloudflare R2:
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="engecom-uploads"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
ADMIN_SEED_NAME="Administrador ENGECOM"
ADMIN_SEED_EMAIL="admin@engecom.com.br"
ADMIN_SEED_PASSWORD="ChangeMe123!"
