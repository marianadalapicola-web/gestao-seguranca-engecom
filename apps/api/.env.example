DATABASE_URL="postgresql://engecom:engecom_dev_password@localhost:5432/engecom_seguranca?schema=public"
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_DOMAIN=""
# Comma-separated list of allowed frontend origins (no trailing slash).
# Same-origin deployments (API also serving the built frontend, e.g. the
# Railway single-service setup) don't strictly need this to match anything
# beyond the default, since same-origin requests carry no Origin header.
# A frontend hosted separately (e.g. on Vercel) MUST be listed here.
WEB_APP_URL="http://localhost:5173"
# 'lax' for same-origin deployments. Set to 'none' when the frontend is on
# a different origin than this API (e.g. Vercel frontend + Railway API) —
# required for the session cookie to be sent cross-site. 'none' is only
# honored by browsers over HTTPS (enforced automatically in code).
COOKIE_SAME_SITE="lax"
UPLOAD_DIR="uploads"
ADMIN_SEED_NAME="Administrador ENGECOM"
ADMIN_SEED_EMAIL="admin@engecom.com.br"
ADMIN_SEED_PASSWORD="ChangeMe123!"
